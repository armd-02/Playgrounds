// Community Mapmaker User Config
{
    "map": {
        "changeMap": true, // 地図切り替え時はtrue
        "tileName": "OSMFJ_POI", // タイル一覧は config-system.jsonc へ
        "viewCenter": [
            135.495697,
            34.702363
        ],
        "viewPitch": 0,
        "maxPitch": 75,
        "maxBounds": "", // 地図の表示範囲(左下[]、右上[])。未指定時は""
        // "_maxBounds": [ // 地図の表示範囲(左下、右上)
        // [133.57441, 34.810416],[134.47147, 35.37144]
        //],
        "initZoom": 11,
        "maxZoom": 22,
        "detailZoom": 17, // モーダルダイアログ表示時のズームサイズ
        "zoomMessageThreshold": 17,
        "textFont": [
            "Noto Sans Bold"
        ], // 使用可能なフォント（spriteに依存）
        "textSize": 12,
        "pointMarkerRadius": 48, // クリック時の点ハイライトの半径（画面上のpx）
        "polygonMarker": { // ポリゴン設定
            "fill-color": "#CC6666",
            "fill-opacity": 0.3
        }
    },
    "news": {
        "use": false, // 地図の対象年・表示地域に対応するニュースを表示する
        "sourceBaseUrl": "",
        "prefectureFile": "",
        "regionalMinZoom": 9.5, // このズーム以上は全国ニュースから都道府県ニュースへ切り替える
        "nationalLimitPerMonth": 5, // 全国ニュースを1か月あたり何件表示するか
        "displayDuration": 10000 // ニュース1件を表示する時間（ミリ秒）
    },
    "changes": {
        "use": true,
        "apiUrl": "https://armd-01.sakura.ne.jp/osm-japan-changes/api.php",
        "storageKeyPrefix": "playgrounds-changes",
        "reviews": { "use": true, "labelKey": "changeFeed_reviewLabel", "placeLabelKey": "changeFeed_reviewPlace" },
        "minLookbackMonths": 1, // 初回に手動で過去履歴を開く際は最低1か月分を確認
        "maxLookbackMonths": 6, // 前回が古くても半年で打ち切る
        "ticker": { "use": true, "autoOpen": true, "displayDuration": 10000, "maxItems": 30,
            "mobileLabelKey": "changeFeed_reviewsTitle", "mobileLabel": "公園／遊具の口コミや情報更新", "sourceLabel": "OpenStreetMap" },
        "labelKeys": { "regionalCreated": "changeFeed_regionalCreatedLabel", "regionalUpdated": "changeFeed_regionalUpdatedLabel", "favoriteUpdated": "changeFeed_favoriteUpdatedLabel" },
        "labels": { "regionalCreated": "地図への新規登録", "regionalUpdated": "更新", "favoriteUpdated": "お気に入りの更新" },
        "region": {
            "scope": "prefecture", "source": "mapCenter",
            "prefectureFile": "https://armd-01.sakura.ne.jp/osm-japan-changes/data/prefectures.min.geojson"
        },
        "targets": [
            { "id": "park", "glotLabel": "changeFeed_park", "label": "公園", "use": true,
              "notify": { "regionalCreated": true, "regionalUpdated": true, "favoriteUpdated": true },
              "queries": [
                  { "tag_key": "leisure", "tag_value": "park" },
                  { "tag_key": "leisure", "tag_value": "playground" },
                  { "tag_key": "landuse", "tag_value": "recreation_ground" }
              ] },
            { "id": "playground", "glotLabel": "changeFeed_playground", "label": "遊具", "use": true,
              "notify": { "regionalCreated": true, "regionalUpdated": false, "favoriteUpdated": true },
              "queries": [{ "tag_key": "playground" }] },
            { "id": "temple_shrine", "glotLabel": "changeFeed_temple_shrine", "label": "寺社仏閣", "use": false,
              "notify": { "regionalCreated": true, "regionalUpdated": false, "favoriteUpdated": true },
              "queries": [{ "tag_key": "amenity", "tag_value": "place_of_worship" }],
              "matchTags": { "religion": ["buddhist", "shinto"] } },
            { "id": "cinema", "glotLabel": "changeFeed_cinema", "label": "映画館", "use": false,
              "notify": { "regionalCreated": true, "regionalUpdated": false, "favoriteUpdated": true },
              "queries": [{ "tag_key": "amenity", "tag_value": "cinema" }] }
        ]
    },
    "intro": {
        "use": true, // 起動時の案内を1日1回表示する
        "storageKey": "playgrounds-intro-last-shown"
    },
    "areaFeatureLinker": {
        "use": true, // 敷地と、その内側にある地物・Activityを1敷地1レコードへまとめる
        "areaTargets": ["Playgrounds_Park"], // 検索対象のOverpass target（公園以外も指定可能）
        "featureTargets": ["Playgrounds_Play", "Playgrounds_Etc"], // 敷地へ紐づける地物のtarget（空配列なら全target）
        "detailPlayTargets": ["Playgrounds_Play"], // 公園詳細の設備欄で遊具としてまとめるtarget
        "mapMode": "allVisibleFeatures", // 通常時は敷地外を含む表示対象POIも地図に表示
        "parentMarkerBelowZoomTargets": ["Playgrounds_Play", "Playgrounds_Etc"], // カテゴリ選択時、各targetのpoiZoom未満では親敷地マーカーを表示。空配列・未指定なら無効
        "maxParentDepth": 8, // 入れ子の敷地を親方向へたどる上限
        "includeUnlinkedActivities": true, // 敷地へ紐づかないActivityも単独レコードとして残す
        "recentDays": 365, // 「最近確認済み」とする日数
        "activityFields": {
            "score": "score",
            "attributes": "good_points",
            "body": "body",
            "detailUrl": "detail_url"
        },
        "activityDateFields": ["actdate", "updatetime"],
        "photoFieldPattern": "^picture_url\\d+$",
        "scoreCodePattern": "act_score_(\\d+)$",
        "scoreCodeOffset": 1
    },
    "searchUi": { "categoryPresentation": "secondary" }, // 主導線は目的・表示。カテゴリ機能は控えめに残す
    "areaSearch": {
        "previewCounts": false,
        "apiUrl": "activity-search.php", // basic設定の低ズーム検索。activity.urlを基準に解決
        "use": true, // AreaFeatureLinkerが作ったレコードを検索・調査リストに利用する
        "sparseInformationCount": 2, // 「情報が少ない」とする登録項目数の上限
        "ratingActionId": "area-rating",
        "attributes": ["act_good_points_1", "act_good_points_2", "act_good_points_3",
            "act_good_points_4", "act_good_points_5", "act_good_points_6",
            "act_good_points_7", "act_good_points_8", "act_good_points_9", "act_good_points_10"],
        "presets": {
            "small": { "icon": "🧒", "attributes": ["act_good_points_7", "act_good_points_1"], "matchMode": "or" },
            "play": { "icon": "🛝", "attributes": ["act_good_points_2", "act_good_points_3", "act_good_points_8"], "matchMode": "or" },
            "relax": { "icon": "🌿", "attributes": ["act_good_points_4", "act_good_points_5", "act_good_points_6"], "matchMode": "or" },
            "hot": { "icon": "🌳", "attributes": ["act_good_points_5", "act_good_points_6"], "matchMode": "and" },
            "access": { "icon": "🚌", "attributes": ["act_good_points_10"], "matchMode": "and" },
            "rated": { "icon": "⭐", "scoreMin": 4, "attributes": [], "matchMode": "and" }
        }
    },
    "directions": { "use": true }, // Open external route planning from feature details
    "discovery": {
        "use": true,
        "presetIds": ["small", "play", "relax", "hot", "access", "rated"],
        "featureFacts": [
            { "key": "amenity", "value": "toilets", "labelKey": "discovery_fact_restrooms" },
            { "key": "amenity", "value": "bench", "labelKey": "discovery_fact_seating" },
            { "key": "amenity", "value": "drinking_water", "labelKey": "discovery_fact_water" }
        ]
    },
    "listActions": {
        "use": true, // リスト上部の汎用アクションボタンを表示する
        "items": [
            {
                "id": "area-rating",
                "use": false,
                "glotLabel": "listActionRating",
                "icon": "fas fa-star",
                "buttonClass": "btn-light border-secondary",
                "glotAriaLabel": "listActionRatingAria",
                "handler": "areaSearchController.open",
                "args": ["rating"]
            }
        ]
    },
    "minimap": { // 地球儀表示時の初期設定
        "use": false, // 地球儀利用時はtrue
        "height": 200,
        "initZoom": 2,
        "viewCenter": [
            135,
            34
        ]
    },
    "icon": {
        "fgPath": "icon",
        "bgPath": "image",
        "shadow": 0.7,
        "attention": 0.8,
        "green": 0.6,
        "middle": 0.8,
        "visited": 0.6,
        "normal": 0.8,
        "flag": 0.5,
        "zoomSteps": { // ズームレベルに応じたマーカー倍率
            "marker": {
                "baseScale": 0.5, // 最初のsteps.zoom未満
                "steps": [
                    { "zoom": 12, "scale": 0.1 },
                    { "zoom": 13, "scale": 0.2 },
                    { "zoom": 14, "scale": 0.3 },
                    { "zoom": 15, "scale": 0.4 },
                    { "zoom": 16, "scale": 0.6 },
                    { "zoom": 17, "scale": 0.65 }
                ]
            },
            "shadow": {
                "baseScale": 0.5, // 最初のsteps.zoom未満
                "steps": [
                    { "zoom": 12, "scale": 0.1 },
                    { "zoom": 13, "scale": 0.2 },
                    { "zoom": 14, "scale": 0.3 },
                    { "zoom": 15, "scale": 0.45 },
                    { "zoom": 16, "scale": 0.7 },
                    { "zoom": 17, "scale": 1.0 }
                ]
            }
        },
        "textFont": [
            "Noto Sans Regular"
        ], // 使用可能なフォント（spriteに依存）
        "textSize": 12,
        "textViewZoom": 14, // アイコンに文字を表示するズームレベル
        "markerColors": {
            "hover": {
                "enabled": false,
                "stroke": "#e9a05b"
            },
            "attention": {
                "fill": "#ffffff",
                "stroke": "#ffc786"
            },
            "green": {
                "fill": "#ffffff",
                "stroke": "#51b3a1"
            },
            "middle": {
                "fill": "#ffffff",
                "stroke": "#4d77ac"
            },
            "normal": {
                "fill": "#ffffff",
                "stroke": "#bfbfe1"
            },
            "favorite": {
                "badgeColor": "#d14970"
            },
            "visited": {
                "fill": "#ffffff",
                "stroke": "#9c9c9c"
            }
        }
    },
    "feature3d": {
        "use": true, // false: 従来のアイコン表示。表示ズームはアイコンと共通
        "visualScale": 1.0, // 地図記号として見やすくする全モデル共通倍率
        "hitArea": {
            "use": true, // モデル全体を覆う透明なタップ領域を使用
            "padding": 0.35, // モデル外形から広げる距離(m)
            "minSize": 2.0 // 各辺の最小サイズ(m)
        },
        // モデルIDごとにURLと最長辺のサイズ(m)を指定。use:falseで個別に無効化
        "models": {
            "slide": {
                "url": "./assets/models/playground/leonkin-playground/GLTF/slide.glb",
                "size": 4
            },
            "dome": {
                "url": "./assets/models/playground/handmade/playground_dome.glb",
                "size": 4
            },
            "swing": {
                "url": "./assets/models/playground/poly-pizza/swing-set/swing.glb",
                "size": 4
            },
            "sandpit": {
                "url": "./assets/models/playground/sketchfab/sandbox-hene/scene.gltf",
                "size": 3
            },
            "climbingframe": {
                "url": "./assets/models/playground/poly-pizza/jungle-gym/jungle-gym.glb",
                "size": 5
            },
            "monkey_bars": {
                "url": "./assets/models/playground/handmade/playground_monkey_bars.glb",
                "size": 3.1
            },
            "structure": {
                "url": "./assets/models/playground/poly-pizza/composite-play-structure/composite-play-structure.glb",
                "size": 8
            },
            "seesaw": {
                "url": "./assets/models/playground/poly-pizza/seesaw/seesaw.glb",
                "size": 4
            },
            "basket_swing": {
                "type": "basket_swing",
                "size": 1
            },
            "horizontal_bar": {
                "type": "horizontal_bar",
                "size": 1
            },
            "ride_on": {
                "type": "springy",
                "size": 1
            },
            "springy": {
                "type": "springy",
                "size": 1
            },
            "bench": {
                "url": "./assets/models/poi/bench/scene.gltf",
                "size": 2
            },
            "drinking_water": {
                "url": "./assets/models/poi/drinking-water/scene.gltf",
                "size": 1.2,
                "scaleBelowZoom": 19,
                "maxZoomScale": 4
            },
            "vending_machine": {
                "url": "./assets/models/poi/vending-machine/scene.gltf",
                "size": 1.9,
                "scaleBelowZoom": 19,
                "maxZoomScale": 4
            }
        },
        // 上から最初に一致したルールを使用。タグ間はAND、値の配列はOR（大文字小文字を区別しない）
        // use:falseでルールを無効化。未一致・モデル読込失敗時は従来アイコン
        "rules": [
            {
                "tags": {
                    "playground": "slide"
                },
                "model": "slide"
            },
            {
                "tags": {
                    "playground": "dome"
                },
                "model": "dome"
            },
            {
                "tags": {
                    "playground": "swing"
                },
                "model": "swing"
            },
            {
                "tags": {
                    "playground": [
                        "sandpit",
                        "sandbox"
                    ]
                },
                "model": "sandpit"
            },
            {
                "tags": {
                    "playground": [
                        "climbingframe",
                        "climbing_frame",
                        "jungle_gym"
                    ]
                },
                "model": "climbingframe"
            },
            {
                "tags": {
                    "playground": "monkey_bars"
                },
                "model": "monkey_bars"
            },
            {
                "tags": {
                    "playground": "structure"
                },
                "model": "structure"
            },
            {
                "tags": {
                    "playground": "seesaw"
                },
                "model": "seesaw"
            },
            {
                "tags": {
                    "playground": [
                        "basketswing",
                        "basket_swing"
                    ]
                },
                "model": "basket_swing"
            },
            {
                "tags": {
                    "playground": "horizontal_bar"
                },
                "model": "horizontal_bar"
            },
            {
                "tags": {
                    "playground": "ride_on"
                },
                "model": "springy"
            },
            {
                "tags": {
                    "playground": "springy"
                },
                "model": "springy"
            },
            {
                "tags": {
                    "amenity": "bench"
                },
                "model": "bench"
            },
            {
                "tags": {
                    "amenity": "drinking_water"
                },
                "model": "drinking_water"
            },
            {
                "tags": {
                    "amenity": "vending_machine"
                },
                "model": "vending_machine"
            }
        ]
    },
    "poiView": {
        "poiActLoad": false, // 起動時にActivityを読み込むか
        "poiFilter": "", // poiView時の表示範囲 all:画面外も表示 / "":画面内だけを表示
        "poiZoom": {
            // アイコンの前後位置は後ろの方が手前になる
            "Playgrounds_Park": 12,
            "Playgrounds_Play": 14.5,
            "Playgrounds_Etc": 17,
            "Green": 16,
            "activity": 15
        },
        "mobilePoiZoom": {},
        "editZoom": {
            // 編集時に追加するpoiZoom
            "Playgrounds_Park": 16,
            "Playgrounds_Play": 16
        }
    },
    "poiData": {
        "maxFeatures": 12000,
        "pruneThreshold": 15000,
        "applyToStatic": false
    },
    "selectItem": { // 選択リストの内容を手動記載 / 空の時は "" とする
        "showAutoOption": true,
        "default": "",
        "menu": "",
        "action": "ChangePoi" // ChangeMap:背景地図切り替え / ChangePoi:メニューに会ったOverpass名のPOIを表示 / "":google Spreadseedのcategory
    },
    "sideBar": {
        "everyView": true, // すべてのビューでサイドバーを表示するか
        "initView": "view" // 空は非表示 / view:表示 / change:表示と拡大の切り替え / mini:縦の時はタイトルのみ表示。横の時は非表示 / list:リスト表示
    },
    "thumbnail": {
        "use": true,
        "limits": 16, // 画像の制限数
        "slideThumbWidth": "320",
        "modalThumbWidth": "800"
    },
    "activity": {
        "url": "https://armd-01.sakura.ne.jp/community-mapmaker-backend/api/activities.php?app=playgrounds",
        "authMode": "basic", // basic: HTTP Basic認証のJSON API / legacy: 従来のGAS salt認証
        "targetName": "activity",
        "local": {
            "use": true,
            "hosts": ["127.0.0.1", "localhost", "::1", "192.168.1.6", "100.64.18.48"],
            "url": "http://127.0.0.1:18080/api/activities.php?app=playgrounds",
            "schemaUrl": "http://127.0.0.1:18080/api/activity-schema.php",
            "app": "playgrounds",
            "formName": "Playgrounds",
            "excludeFields": ["updatetime", "updateuser", "category"]
        }
    },
    "static": {
        "use": false,
        "osmjsons": []
    },
    "indoor": {
        "use": false,
        "defaultLevel": "0",
        "floorHeightMeters": 3.66,
        "buildingLevelHeightMeters": 3.66,
        "floorOffsetMeters": 0.2,
        "backgroundTransportationOpacity": 0.08,
        "buildingSource": {
            "type": "vectorTile",
            "styleSource": "openmaptiles",
            "dedicatedSource": "indoor-building-tiles",
            "sourceUrl": "",
            "sourceLayer": "building",
            "heightProperty": "render_height",
            "minHeightProperty": "render_min_height",
            "deduplicate": true
        },
        "fallbackLevels": {
            "highway=corridor": "0"
        },
        "underground": {
            "useWithoutBuilding": false,
            "activationRadiusMeters": 60
        },
        "largeBuildingActivation": {
            "use": false,
            "minZoom": 15,
            "referenceZoom": 18,
            "viewportCoverageRatio": 1.0,
            "groupNearbyBuildings": false
        },
        "buildingGroup": {
            "smallBuildingAreaSquareMeters": 1500,
            "groupRadiusMeters": 50,
            "activationRadiusMeters": 50,
            "requireIndoorPoi": true
        },
        "levels": {
            "discoverFromData": false,
            "labels": {
                "roof": "屋上"
            },
            "order": [
                "0"
            ]
        },
        "control": {
            "view": false,
            "urlParameter": "level",
            "label": "フロア"
        }
    },
    "wikipedia": {
        "marker": "wikipedia.svg",
        "api_": "wikipedia.org/w/api.php?format=json&action=query&prop=extracts%7Cimages&exintro=&explaintext=&titles=",
        "api": "wikipedia.org/api/rest_v1/page/summary/",
        "domain": "wikipedia.org",
        "tag": "wikipedia"
    },
    "etc": {
        "publicUrl": "https://playgrounds.openacrossbase.net/", // URL sharing destination
        "localSave": "playgrounds", // POI記録のアプリ固有キー(無効時は"")
        "reverseIcon": false, // true:訪問済みを目立たせる / false:訪問済みを目立たせない
        "editMode": true, // 編集メニューの表示/非表示
        "splashUrl": "./image/ogimage.png",
        "loadingUrl": "./image/loading.gif"
    },
    "menu": {
        "main": [
            // トップメニュー一覧
            {
                "glot-model": "reviewContribute",
                "linkto": "javascript:areaSearchController.open('research')",
                "divider": true
            },
            {
                "glot-model": "about",
                "linkto": "javascript:cMapMaker.about()",
                "divider": false
            },
            {
                "glot-model": "licence_title",
                "linkto": "javascript:cMapMaker.licence()",
                "divider": false
            },
            {
                "glot-model": "develop_site",
                "linkto": "https://github.com/armd-02/Playgrounds",
                "divider": false
            },
            {
                "glot-model": "openstreetmap",
                "linkto": "https://www.openstreetmap.org/about",
                "divider": true
            },
            {
                "glot-model": "UseOVCacheYes",
                "linkto": "javascript:cMapMaker.setCacheMode(true)",
                "divider": false
            },
            {
                "glot-model": "UseOVCacheNo",
                "linkto": "javascript:cMapMaker.setCacheMode(false)",
                "divider": false
            }
        ],
        "mainSystem": [
            /*
            {
                "glot-model": "export_visited",
                "linkto": "javascript:poiStatusCont.export()",
                "divider": false
            },
            {
                "glot-model": "import_visited",
                "linkto": "javascript:poiStatusCont.import()",
                "divider": false
            }
                */
        ],
        // 詳細表示のハンバーガーメニュー
        "modal": [
            {
                "glot-model": "reviewAdd",
                "linkto": "javascript:modalActs.edit({form:'Playgrounds'})",
                "divider": false
            },
            {
                "glot-model": "copyShareLink",
                "linkto": "javascript:cMapMaker.shareURL()",
                "divider": false
            },
            {
                "glot-model": "osm_open",
                "linkto": "javascript:winCont.osm_open(cMapMaker.openOSMid)",
                "divider": false
            }
        ],
        // 詳細モーダルの追加ボタン
        "activities": [
            {
                "btn_class": "btn btn-light btn-lg border-secondary w-75 m-2 p-1",
                "code": "modalActs.edit({form:'Playgrounds'})",
                "icon_class": "fas fa-clone",
                "btn_glot_name": "reviewAdd"
            }
        ],
        "editActivity": [
            {
                "btn_class": "btn btn-light btn-lg border-secondary w-50 m-2 p-1",
                "code": "javascript:modalActs.save()",
                "icon_class": "fa-solid fa-cloud-arrow-up",
                "btn_glot_name": "act_save"
            }
        ],
        "deleteActivity": [
            {
                "btn_class": "btn btn-outline-danger btn-lg w-50 m-2 p-1",
                "code": "javascript:modalActs.remove()",
                "icon_class": "fa-solid fa-trash-can",
                "btn_glot_name": "act_delete",
                "editMode": true
            }
        ],
        "visited": [
            {
                "btn_class": "btn btn-light border-secondary pe-auto",
                "code": "javascript:poiStatusCont.import_load()",
                "icon_class": "fa-solid fa-cloud-arrow-up",
                "btn_glot_name": "act_upload"
            }
        ]
    }
}
